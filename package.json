{
  "name": "flight-studio-v2",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Lokales 3D-Flugstudio mit IGC, Videos, Fotos und MP4-Export",
  "scripts": {
    "start": "node server.mjs",
    "pretest": "npm run fixtures",
    "test": "node --test tests/*.test.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "desktop": "electron .",
    "build:desktop": "electron-builder --win nsis portable --x64",
    "docs": "node scripts/write-guides.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cesium": "^1.130.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "main": "desktop/main.cjs",
  "author": "FlightStudio",
  "license": "MIT",
  "build": {
    "appId": "ch.flightstudio.v2",
    "productName": "FlightStudio V2",
    "directories": {
      "output": "release/desktop-2.5.0",
      "buildResources": "desktop"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "npmRebuild": false,
    "files": [
      "desktop/**",
      "public/**",
      "docs/**",
      "lib/**",
      "server.mjs",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**",
      "!node_modules/cesium/{Apps,Documentation,Specs,Source}/**",
      "!node_modules/cesium/Build/CesiumUnminified/**"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "FlightStudio-V2-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "FlightStudio-V2-Portable-${version}.${ext}"
    }
  }
}
